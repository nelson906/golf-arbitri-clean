# Config PHPStan del progetto (in CI: --level=9, vedi .github/workflows/ci.yml).
#
#   vendor/bin/phpstan analyse -c phpstan-strict.neon --level=9 --memory-limit=1G
#
# Nessun ignoreErrors e nessuna esclusione di path: non riaggiungerne.
# Il livello 9 e' a zero dal 2026-09-06; il livello 10 (default di questo
# file) e' la prossima tappa. phpstan.neon resta solo in locale (.gitignore).

includes:
    - vendor/larastan/larastan/extension.neon
    # Narrowing delle asserzioni PHPUnit: senza questa estensione un
    # assertNotNull($x) non restringe il tipo e ogni $x->prop successivo
    # resta un errore di livello 8 dentro i test.
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 10

    paths:
        - app
        - database
        - routes
        - tests

    excludePaths:
        analyseAndScan:
            - vendor
            - node_modules

    treatPhpDocTypesAsCertain: false
    tmpDir: storage/framework/cache/phpstan
