{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "laravel/breeze": "^2.3",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.2",
        "laravel/tinker": "^2.9",
        "phpoffice/phpspreadsheet": "^5.10",
        "phpoffice/phpword": "^1.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.92",
        "infection/infection": "^0.34.0",
        "larastan/larastan": "^3.8",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.0.1",
        "shipmonk/dead-code-detector": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "_comment_verifica": "Un comando solo per sapere se una modifica ha rotto qualcosa. Ordine: analizzatori e codice morto, suite e build, poi il giro di tutte le pagine sul DB di MAMP con le pagine che leggono di piu' il database, il controllo dati (solo rapporto, non blocca) e le vulnerabilita' dei pacchetti.",
        "verifica": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpstan analyse -c phpstan-strict.neon --level=9 --memory-limit=1G",
            "@codice-morto",
            "npm run qa",
            "@php vendor/bin/phpunit",
            "npm run build",
            "@php artisan golf:giro-pagine --letture",
            "@php artisan golf:controlla-dati",
            "@composer audit --abandoned=report"
        ],
        "_comment_codice_morto": "Codice PHP mai usato (shipmonk). E' a zero dal 2026-10-09 ed e' dentro composer verifica: una voce nuova la fa fallire. Prima di togliere, verifica anche in resources/views e routes; un falso allarme va in phpstan-deadcode.neon con il motivo.",
        "codice-morto": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpstan analyse -c phpstan-deadcode.neon --memory-limit=2G"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "stan": "php -d memory_limit=1G ./vendor/bin/phpstan analyse -c phpstan.neon --no-progress",
        "stan:clear": "php -d memory_limit=1G ./vendor/bin/phpstan clear-result-cache"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
